# ==========================================
# CIB GHANA EVENTS PLATFORM ENVIRONMENT CONFIG
# ==========================================

# Backend API URL (Proxied via Vite or set to production server)
VITE_API_URL=/api

# Supabase (PostgreSQL Database & Authentication)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Access Bank Ghana – WebPay (Collections WEB_ACQ)
VITE_ACCESS_WEBPAY_MERCHANT_ID=WEB_ACQ
VITE_ACCESS_WEBPAY_GATEWAY_URL=https://apps.ghana.accessbankplc.com/webpay/Checkout/v1

# Transactional Email (Resend API for ticket passes and confirmation receipts)
RESEND_API_KEY=re_your_resend_api_key

# ==========================================
# ACCESS BANK GHANA – WEBPAY PAYMENT GATEWAY
# ==========================================
ACCESS_WEBPAY_SERVICE_CODE=TjBFMmVscGxlVmRhUjI0eC5kZXYuTW5sM05FNXhWamxhY1dkUQ==
ACCESS_WEBPAY_IS_TEST=true
ACCESS_WEBPAY_INIT_URL=https://apps.ghana.accessbankplc.com/webpay/Checkout/v1/Test/Init
ACCESS_WEBPAY_STATUS_URL=https://apps.ghana.accessbankplc.com/webpay/Checkout/v1/Transaction/Status


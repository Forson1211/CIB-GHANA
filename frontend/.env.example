# ==========================================
# CIB GHANA EVENTS PLATFORM ENVIRONMENT CONFIG
# ==========================================

# Backend API URL (Proxied via Vite or set to production server)
VITE_API_URL=/api

# Supabase (PostgreSQL Database & Authentication)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Paystack (Payment Gateway for Ghana Cedis - Cards & Mobile Money)
VITE_PAYSTACK_PUBLIC_KEY=pk_test_your_paystack_public_key

# Transactional Email (Resend API for ticket passes and confirmation receipts)
RESEND_API_KEY=re_your_resend_api_key

# ==========================================
# ACCESS BANK GHANA – WEBPAY PAYMENT GATEWAY
# ==========================================
# Set to 'true' to activate the live WebPay gateway
ACCESS_WEBPAY_ENABLED=false
# Host / Base URL provided by Access Bank Ghana e-channels
ACCESS_WEBPAY_BASE_URL=https://gateway.accessbankplc.com.gh
# Merchant ID issued by Access Bank Ghana
ACCESS_WEBPAY_MERCHANT_ID=your_access_merchant_id
# API Key issued by Access Bank Ghana e-channels
ACCESS_WEBPAY_API_KEY=your_access_api_key
# Webhook / Hashing Secret (Optional)
ACCESS_WEBPAY_SECRET_KEY=your_access_secret_key
# Environment: 'sandbox' or 'live'
ACCESS_WEBPAY_ENV=sandbox


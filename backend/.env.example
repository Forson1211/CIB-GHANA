# ===============================================
# CIB GHANA BACKEND CONFIGURATION
# ===============================================

# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Supabase (PostgreSQL Database & Admin Auth)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Paystack (Ghana Payments - Cards & Mobile Money)
PAYSTACK_SECRET_KEY=sk_test_your_paystack_secret_key
PAYSTACK_PUBLIC_KEY=pk_test_your_paystack_public_key

# ===============================================
# Email Service: Configure Either Resend OR SMTP
# ===============================================

# Option A: Resend API (Get free key at https://resend.com)
RESEND_API_KEY=re_your_resend_api_key
FROM_EMAIL=events@cibghana.org

# Option B: Standard SMTP (Gmail, Brevo, SendGrid, Zoho, cPanel, or institutional mail server)
# For Gmail: Use host=smtp.gmail.com, port=465, secure=true, and generate a 16-character Google App Password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-google-app-password
SMTP_FROM="Chartered Institute of Bankers, Ghana <events@cibghana.org>"

# ===============================================
# Real-Time AI Assistant (Gemini / OpenAI / Groq)
# ===============================================
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
GROQ_API_KEY=your_groq_api_key_here
